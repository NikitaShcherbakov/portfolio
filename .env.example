# Environment variables without values. Copy to .env.local and fill in.
# Variables used in the browser need the VITE_ prefix: https://vite.dev/guide/env-and-mode

# Cloudflare R2, read only by `pnpm sync:music` (never VITE_: these are secrets).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
